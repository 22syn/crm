# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Shopify Storefront API (optional, per client). Leave both empty to hide the
# product catalog: Products and the quote builder show "not connected".
VITE_SHOPIFY_STORE_DOMAIN=
VITE_SHOPIFY_STOREFRONT_TOKEN=

# Branding shown on the login page: "leads" or "ad_agency" (that module's
# company_settings row). Leave empty on a deployment shared by several clients:
# the login page then shows the Xsheva defaults.
VITE_BRAND_MODULE=
