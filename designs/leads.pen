{
  "version": "2.6",
  "children": [
    {
      "type": "frame",
      "id": "LdRoot",
      "x": 0,
      "y": 0,
      "name": "Leads",
      "width": 1440,
      "height": "fit_content(1200)",
      "fill": "#ffffff",
      "layout": "vertical",
      "gap": 24,
      "padding": 32,
      "children": [
        {
          "type": "frame",
          "id": "LdHead",
          "name": "header",
          "width": "fill_container",
          "layout": "horizontal",
          "justifyContent": "space_between",
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "LdTitle",
              "name": "titleBlock",
              "layout": "vertical",
              "gap": 4,
              "children": [
                { "type": "text", "id": "LdT1", "content": "Leads", "fill": "#1a1a1a", "fontSize": 28, "fontWeight": "600" },
                { "type": "text", "id": "LdT2", "content": "Manage and track leads", "fill": "#737373", "fontSize": 14 }
              ]
            },
            {
              "type": "frame",
              "id": "LdAddBtn",
              "name": "addButton",
              "height": 36,
              "padding": [8, 16],
              "fill": "hsl(262, 55%, 50%)",
              "cornerRadius": 6,
              "layout": "horizontal",
              "alignItems": "center",
              "gap": 8,
              "children": [
                { "type": "text", "id": "LdAddT", "content": "+ Add Lead", "fill": "#ffffff", "fontSize": 14, "fontWeight": "500" }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "LdTool",
          "name": "toolbar",
          "width": "fill_container",
          "layout": "horizontal",
          "justifyContent": "space_between",
          "alignItems": "center",
          "gap": 16,
          "children": [
            {
              "type": "frame",
              "id": "LdFlt",
              "name": "filters",
              "layout": "horizontal",
              "gap": 12,
              "alignItems": "center",
              "children": [
                {
                  "type": "frame",
                  "id": "LdSrc",
                  "name": "sourceFilter",
                  "width": 140,
                  "height": 36,
                  "fill": "#ffffff",
                  "cornerRadius": 6,
                  "padding": [8, 12],
                  "stroke": { "align": "inside", "thickness": 1, "fill": "hsl(220, 15%, 90%)" },
                  "layout": "horizontal",
                  "alignItems": "center",
                  "children": [
                    { "type": "text", "id": "LdSrcT", "content": "Source", "fill": "#4a4a4a", "fontSize": 14 }
                  ]
                },
                {
                  "type": "frame",
                  "id": "LdSts",
                  "name": "statusFilter",
                  "width": 140,
                  "height": 36,
                  "fill": "#ffffff",
                  "cornerRadius": 6,
                  "padding": [8, 12],
                  "stroke": { "align": "inside", "thickness": 1, "fill": "hsl(220, 15%, 90%)" },
                  "layout": "horizontal",
                  "alignItems": "center",
                  "children": [
                    { "type": "text", "id": "LdStsT", "content": "Status", "fill": "#4a4a4a", "fontSize": 14 }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "LdView",
              "name": "viewToggle",
              "layout": "horizontal",
              "gap": 4,
              "children": [
                {
                  "type": "frame",
                  "id": "LdVt",
                  "name": "tableBtn",
                  "width": 36,
                  "height": 36,
                  "fill": "hsl(262, 55%, 50%)",
                  "cornerRadius": 6,
                  "layout": "horizontal",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "children": [
                    { "type": "text", "id": "LdVtT", "content": "⊞", "fill": "#ffffff", "fontSize": 16 }
                  ]
                },
                {
                  "type": "frame",
                  "id": "LdVk",
                  "name": "kanbanBtn",
                  "width": 36,
                  "height": 36,
                  "fill": "hsl(220, 15%, 95%)",
                  "cornerRadius": 6,
                  "stroke": { "align": "inside", "thickness": 1, "fill": "hsl(220, 15%, 90%)" },
                  "layout": "horizontal",
                  "alignItems": "center",
                  "justifyContent": "center",
                  "children": [
                    { "type": "text", "id": "LdVkT", "content": "▦", "fill": "#4a4a4a", "fontSize": 14 }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "LdTable",
          "name": "tableArea",
          "width": "fill_container",
          "height": 480,
          "layout": "vertical",
          "fill": "hsl(220, 15%, 99%)",
          "cornerRadius": 8,
          "padding": 24,
          "stroke": { "align": "inside", "thickness": 1, "fill": "hsl(220, 15%, 90%)" },
          "children": [
            {
              "type": "frame",
              "id": "LdTblHead",
              "name": "tableHeader",
              "width": "fill_container",
              "layout": "horizontal",
              "padding": [0, 0, 12, 0],
              "stroke": { "align": "inside", "thickness": 0, "fill": "transparent" },
              "children": [
                { "type": "text", "id": "LdTh1", "content": "Name", "fill": "#4a4a4a", "fontSize": 12, "fontWeight": "600" },
                { "type": "text", "id": "LdTh2", "content": "Phone", "fill": "#4a4a4a", "fontSize": 12, "fontWeight": "600" },
                { "type": "text", "id": "LdTh3", "content": "Source", "fill": "#4a4a4a", "fontSize": 12, "fontWeight": "600" },
                { "type": "text", "id": "LdTh4", "content": "Status", "fill": "#4a4a4a", "fontSize": 12, "fontWeight": "600" }
              ]
            },
            {
              "type": "frame",
              "id": "LdTblRow1",
              "name": "tableRow1",
              "width": "fill_container",
              "layout": "horizontal",
              "padding": [12, 0],
              "gap": 16,
              "children": [
                { "type": "text", "id": "LdR1n", "content": "Yael Cohen", "fill": "#1a1a1a", "fontSize": 14 },
                { "type": "text", "id": "LdR1p", "content": "+972-50-111-2233", "fill": "#4a4a4a", "fontSize": 14 },
                { "type": "text", "id": "LdR1s", "content": "Instagram", "fill": "#4a4a4a", "fontSize": 14 },
                {
                  "type": "frame",
                  "id": "LdR1b",
                  "name": "badge",
                  "padding": [4, 8],
                  "fill": "hsl(220, 20%, 95%)",
                  "cornerRadius": 4,
                  "children": [
                    { "type": "text", "id": "LdR1bt", "content": "New", "fill": "#4a4a4a", "fontSize": 12 }
                  ]
                }
              ]
            },
            {
              "type": "frame",
              "id": "LdTblRow2",
              "name": "tableRow2",
              "width": "fill_container",
              "layout": "horizontal",
              "padding": [12, 0],
              "gap": 16,
              "children": [
                { "type": "text", "id": "LdR2n", "content": "David Levi", "fill": "#1a1a1a", "fontSize": 14 },
                { "type": "text", "id": "LdR2p", "content": "+972-52-222-3344", "fill": "#4a4a4a", "fontSize": 14 },
                { "type": "text", "id": "LdR2s", "content": "Website", "fill": "#4a4a4a", "fontSize": 14 },
                {
                  "type": "frame",
                  "id": "LdR2b",
                  "name": "badge",
                  "padding": [4, 8],
                  "fill": "hsl(220, 20%, 95%)",
                  "cornerRadius": 4,
                  "children": [
                    { "type": "text", "id": "LdR2bt", "content": "In Process", "fill": "#4a4a4a", "fontSize": 12 }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
