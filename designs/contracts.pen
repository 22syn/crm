{
  "version": "2.6",
  "children": [
    {
      "type": "frame",
      "id": "CtRoot",
      "x": 0,
      "y": 0,
      "name": "Contracts",
      "width": 1440,
      "height": "fit_content(1200)",
      "fill": "#ffffff",
      "layout": "vertical",
      "gap": 24,
      "padding": 32,
      "children": [
        {
          "type": "frame",
          "id": "CtHead",
          "name": "header",
          "width": "fill_container",
          "layout": "horizontal",
          "justifyContent": "space_between",
          "alignItems": "center",
          "children": [
            {
              "type": "frame",
              "id": "CtTitle",
              "name": "titleBlock",
              "layout": "vertical",
              "gap": 4,
              "children": [
                { "type": "text", "id": "CtT1", "content": "Contracts", "fill": "#1a1a1a", "fontSize": 28, "fontWeight": "600" },
                { "type": "text", "id": "CtT2", "content": "Manage and create customer contracts", "fill": "#737373", "fontSize": 14 }
              ]
            },
            {
              "type": "frame",
              "id": "CtAddBtn",
              "name": "addButton",
              "height": 36,
              "padding": [8, 16],
              "fill": "hsl(262, 55%, 50%)",
              "cornerRadius": 6,
              "layout": "horizontal",
              "alignItems": "center",
              "gap": 8,
              "children": [
                { "type": "text", "id": "CtAddT", "content": "+ New Contract", "fill": "#ffffff", "fontSize": 14, "fontWeight": "500" }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "CtTabs",
          "name": "viewTabs",
          "width": "fill_container",
          "layout": "horizontal",
          "gap": 4,
          "children": [
            {
              "type": "frame",
              "id": "CtTabP",
              "name": "pipelineTab",
              "height": 36,
              "padding": [8, 16],
              "fill": "hsl(262, 55%, 50%)",
              "cornerRadius": 6,
              "layout": "horizontal",
              "alignItems": "center",
              "children": [
                { "type": "text", "id": "CtTabPT", "content": "Pipeline", "fill": "#ffffff", "fontSize": 14, "fontWeight": "500" }
              ]
            },
            {
              "type": "frame",
              "id": "CtTabT",
              "name": "tableTab",
              "height": 36,
              "padding": [8, 16],
              "fill": "hsl(220, 15%, 95%)",
              "cornerRadius": 6,
              "stroke": { "align": "inside", "thickness": 1, "fill": "hsl(220, 15%, 90%)" },
              "layout": "horizontal",
              "alignItems": "center",
              "children": [
                { "type": "text", "id": "CtTabTT", "content": "Table", "fill": "#4a4a4a", "fontSize": 14 }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "CtTable",
          "name": "tableArea",
          "width": "fill_container",
          "height": 400,
          "layout": "vertical",
          "fill": "hsl(220, 15%, 99%)",
          "cornerRadius": 8,
          "padding": 24,
          "stroke": { "align": "inside", "thickness": 1, "fill": "hsl(220, 15%, 90%)" },
          "children": [
            {
              "type": "frame",
              "id": "CtTblHead",
              "name": "tableHeader",
              "width": "fill_container",
              "layout": "horizontal",
              "padding": [0, 0, 12, 0],
              "children": [
                { "type": "text", "id": "CtTh1", "content": "Contract #", "fill": "#4a4a4a", "fontSize": 12, "fontWeight": "600" },
                { "type": "text", "id": "CtTh2", "content": "Lead", "fill": "#4a4a4a", "fontSize": 12, "fontWeight": "600" },
                { "type": "text", "id": "CtTh3", "content": "Total", "fill": "#4a4a4a", "fontSize": 12, "fontWeight": "600" },
                { "type": "text", "id": "CtTh4", "content": "Status", "fill": "#4a4a4a", "fontSize": 12, "fontWeight": "600" }
              ]
            },
            {
              "type": "frame",
              "id": "CtTblRow1",
              "name": "tableRow",
              "width": "fill_container",
              "layout": "horizontal",
              "padding": [12, 0],
              "gap": 16,
              "children": [
                { "type": "text", "id": "CtR1n", "content": "Q-20260302-0001", "fill": "#1a1a1a", "fontSize": 14 },
                { "type": "text", "id": "CtR1l", "content": "Yael Cohen", "fill": "#4a4a4a", "fontSize": 14 },
                { "type": "text", "id": "CtR1t", "content": "₪45,000", "fill": "#4a4a4a", "fontSize": 14 },
                {
                  "type": "frame",
                  "id": "CtR1b",
                  "name": "badge",
                  "padding": [4, 8],
                  "fill": "hsl(220, 20%, 95%)",
                  "cornerRadius": 4,
                  "children": [
                    { "type": "text", "id": "CtR1bt", "content": "Draft", "fill": "#4a4a4a", "fontSize": 12 }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
