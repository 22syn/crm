{
  "version": "2.6",
  "children": [
    {
      "type": "frame",
      "id": "tIDKN",
      "x": 0,
      "y": 0,
      "name": "Design System",
      "width": 800,
      "height": 1200,
      "fill": "#ffffff",
      "layout": "vertical",
      "gap": 32,
      "padding": 32,
      "children": [
        {
          "type": "text",
          "id": "colorsLabel",
          "content": "Colors",
          "fill": "#1a1a1a",
          "fontSize": 18,
          "fontWeight": "600"
        },
        {
          "type": "frame",
          "id": "colorRow",
          "name": "colorRow",
          "layout": "horizontal",
          "gap": 16,
          "children": [
            {
              "type": "rectangle",
              "id": "primarySwatch",
              "width": 80,
              "height": 48,
              "fill": "hsl(220, 20%, 25%)",
              "cornerRadius": 6
            },
            {
              "type": "rectangle",
              "id": "secondarySwatch",
              "width": 80,
              "height": 48,
              "fill": "hsl(220, 20%, 95%)",
              "cornerRadius": 6
            },
            {
              "type": "rectangle",
              "id": "accentSwatch",
              "width": 80,
              "height": 48,
              "fill": "hsl(262, 55%, 50%)",
              "cornerRadius": 6
            },
            {
              "type": "rectangle",
              "id": "successSwatch",
              "width": 80,
              "height": 48,
              "fill": "hsl(142, 65%, 42%)",
              "cornerRadius": 6
            },
            {
              "type": "rectangle",
              "id": "sidebarSwatch",
              "width": 80,
              "height": 48,
              "fill": "#0f1025",
              "cornerRadius": 6
            }
          ]
        },
        {
          "type": "text",
          "id": "typoLabel",
          "content": "Typography",
          "fill": "#1a1a1a",
          "fontSize": 18,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "typoDisplay",
          "content": "Display 28px",
          "fill": "#1a1a1a",
          "fontSize": 28,
          "fontWeight": "600"
        },
        {
          "type": "text",
          "id": "typoTitle",
          "content": "Title 18px",
          "fill": "#1a1a1a",
          "fontSize": 18,
          "fontWeight": "500"
        },
        {
          "type": "text",
          "id": "typoBody",
          "content": "Body 14px",
          "fill": "#4a4a4a",
          "fontSize": 14
        },
        {
          "type": "text",
          "id": "typoMeta",
          "content": "Meta 12px",
          "fill": "#737373",
          "fontSize": 12
        },
        {
          "type": "text",
          "id": "spaceLabel",
          "content": "Spacing",
          "fill": "#1a1a1a",
          "fontSize": 18,
          "fontWeight": "600"
        },
        {
          "type": "frame",
          "id": "spaceRow",
          "name": "spaceRow",
          "layout": "horizontal",
          "gap": 24,
          "alignItems": "center",
          "children": [
            {
              "type": "rectangle",
              "id": "space24",
              "width": 24,
              "height": 24,
              "fill": "#e5e5e5",
              "cornerRadius": 4
            },
            {
              "type": "rectangle",
              "id": "space16",
              "width": 16,
              "height": 16,
              "fill": "#e5e5e5",
              "cornerRadius": 4
            },
            {
              "type": "rectangle",
              "id": "space8",
              "width": 8,
              "height": 8,
              "fill": "#e5e5e5",
              "cornerRadius": 4
            }
          ]
        },
        {
          "type": "frame",
          "id": "btnPrimary",
          "name": "Button Primary",
          "reusable": true,
          "layout": "horizontal",
          "width": "fit_content(120)",
          "height": 36,
          "fill": "hsl(262, 55%, 50%)",
          "cornerRadius": 6,
          "gap": 8,
          "padding": [10, 16],
          "justifyContent": "center",
          "alignItems": "center",
          "children": [
            {
              "type": "text",
              "id": "btnL1",
              "content": "Primary",
              "fill": "#ffffff",
              "fontSize": 14,
              "fontWeight": "500"
            }
          ]
        },
        {
          "type": "frame",
          "id": "btnSecondary",
          "name": "Button Secondary",
          "reusable": true,
          "layout": "horizontal",
          "width": "fit_content(120)",
          "height": 36,
          "fill": "hsl(220, 20%, 95%)",
          "cornerRadius": 6,
          "padding": [10, 16],
          "justifyContent": "center",
          "alignItems": "center",
          "stroke": { "align": "inside", "thickness": 1, "fill": "hsl(220, 15%, 90%)" },
          "children": [
            {
              "type": "text",
              "id": "btnL2",
              "content": "Secondary",
              "fill": "#1a1a1a",
              "fontSize": 14,
              "fontWeight": "500"
            }
          ]
        },
        {
          "type": "frame",
          "id": "btnGhost",
          "name": "Button Ghost",
          "reusable": true,
          "layout": "horizontal",
          "width": "fit_content(100)",
          "height": 36,
          "padding": [10, 16],
          "justifyContent": "center",
          "alignItems": "center",
          "children": [
            {
              "type": "text",
              "id": "btnL3",
              "content": "Ghost",
              "fill": "#4a4a4a",
              "fontSize": 14,
              "fontWeight": "500"
            }
          ]
        },
        {
          "type": "frame",
          "id": "inputComp",
          "name": "Input",
          "reusable": true,
          "layout": "vertical",
          "width": 280,
          "height": "fit_content(56)",
          "gap": 6,
          "children": [
            {
              "type": "text",
              "id": "inputLabel",
              "content": "Label",
              "fill": "#4a4a4a",
              "fontSize": 14
            },
            {
              "type": "frame",
              "id": "inputField",
              "width": "fill_container",
              "height": 36,
              "fill": "#ffffff",
              "cornerRadius": 6,
              "padding": [8, 12],
              "layout": "horizontal",
              "alignItems": "center",
              "stroke": { "align": "inside", "thickness": 1, "fill": "hsl(220, 15%, 90%)" },
              "children": [
                {
                  "type": "text",
                  "id": "inputPh",
                  "content": "Placeholder",
                  "fill": "#737373",
                  "fontSize": 14
                }
              ]
            }
          ]
        },
        {
          "type": "frame",
          "id": "cardComp",
          "name": "Card",
          "reusable": true,
          "layout": "vertical",
          "width": 320,
          "height": "fit_content(160)",
          "fill": "hsl(220, 15%, 99%)",
          "cornerRadius": 8,
          "gap": 16,
          "padding": 24,
          "stroke": { "align": "inside", "thickness": 1, "fill": "hsl(220, 15%, 90%)" },
          "children": [
            {
              "type": "text",
              "id": "cardTitle",
              "content": "Card Title",
              "fill": "#1a1a1a",
              "fontSize": 18,
              "fontWeight": "600"
            },
            {
              "type": "text",
              "id": "cardDesc",
              "content": "Card description text",
              "fill": "#4a4a4a",
              "fontSize": 14
            }
          ]
        },
        {
          "type": "frame",
          "id": "badgeComp",
          "name": "Badge",
          "reusable": true,
          "layout": "horizontal",
          "width": "fit_content(60)",
          "height": 22,
          "fill": "hsl(220, 20%, 95%)",
          "cornerRadius": 4,
          "padding": [6, 10],
          "justifyContent": "center",
          "alignItems": "center",
          "children": [
            {
              "type": "text",
              "id": "badgeText",
              "content": "Badge",
              "fill": "#4a4a4a",
              "fontSize": 12
            }
          ]
        }
      ]
    }
  ]
}
